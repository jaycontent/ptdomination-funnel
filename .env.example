# ----- Supabase (create a new project at https://supabase.com) -----
# Project URL and anon key are on: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key (SECRET — server-only, used by /api/submit-lead to insert leads)
# Project Settings -> API -> service_role. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----- Zapier -----
# Create a "Catch Hook" trigger in a Zap and paste its URL here.
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/XXXXXXX/XXXXXXX/

# ----- Site -----
# Public base URL (used for OpenGraph / metadata). Optional in dev.
NEXT_PUBLIC_SITE_URL=https://ptdomination.com
